# Core instance settings
# Generate both secrets independently, for example: openssl rand -base64 48
SESSION_SECRET=
ENCRYPTION_KEY=
# Rotation keyrings are JSON objects. When present, the active IDs select the
# single write key while all configured keys remain readable.
SESSION_SIGNING_KEYS=
SESSION_ACTIVE_KEY_ID=
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=
# For the public SignalHub deployment, use https://signalhub.at.
# Keep the localhost values below for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3301
STATUS_PORT=3301
STATUS_IMAGE=signalhub:local

# PostgreSQL. Docker Compose supplies its own internal URL to containers.
DATABASE_URL=postgresql://signalhub:change-me@127.0.0.1:5432/signalhub
POSTGRES_DB=signalhub
POSTGRES_USER=signalhub
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Identity policy. Organizations and users are created by an Admin; there is
# no public sign-up.
NEXT_PUBLIC_OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Authentication/session policy
TENANT_SESSION_IDLE_SECONDS=28800
TENANT_SESSION_ABSOLUTE_SECONDS=604800
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=14
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1
# Comma-separated IPv4 CIDRs allowed to use installation administration
# (/organization/platform). Requires TRUST_PROXY_HEADERS behind a proxy.
PLATFORM_ADMIN_ALLOWED_CIDRS=

# Development/test sample data is disabled unless explicitly enabled for one command.
# Never set this to true on a production database.
ALLOW_DEV_SEED=false
ENABLE_DEV_QUICK_LOGIN=false
# Required only when running `npm run db:seed-roles`.
DEV_ROLE_PASSWORD=
# Optional fixed password for the sample audience-page user (`npm run db:seed`).
DEV_AUDIENCE_PASSWORD=
# Must equal the target database name for `npm run db:reset-dev`.
CONFIRM_DEV_DATABASE_RESET=
# Development only: return the subscription OTP in the API response.
STATUS_EXPOSE_OTP=false

# SMTP delivery. Port 465 normally uses implicit TLS (SMTP_SECURE=true);
# port 587 normally uses STARTTLS (SMTP_SECURE=false).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SignalHub <status@example.com>

# Optional SMS subscriptions. Numbers use international E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Branding asset storage. Local storage is suitable for a single Docker host.
# Set the driver to s3 for any S3-compatible object store.
ASSET_STORAGE_DRIVER=local
ASSET_LOCAL_DIR=/app/data/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Monitoring policy and worker tuning
MONITOR_ALLOW_PRIVATE_TARGETS=false
MONITOR_ENABLE_ICMP=false
MONITOR_MAX_RESPONSE_BYTES=1048576
WORKER_POLL_INTERVAL_MS=1000
# Stable worker identity for leases; defaults to hostname and process id.
WORKER_ID=
WORKER_MONITOR_SWEEP_MS=1000
WORKER_NOTIFICATION_SWEEP_MS=1000
WORKER_EXPORT_SWEEP_MS=5000
WORKER_AUDIT_DELIVERY_SWEEP_MS=2000
WORKER_PLATFORM_JOB_SWEEP_MS=5000
WORKER_MAINTENANCE_SWEEP_MS=10000
WORKER_CONCURRENCY=10
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_SHUTDOWN_ABORT_TIMEOUT_MS=15000
WORKER_MONITOR_CONCURRENCY=20
WORKER_NOTIFICATION_BATCH=25
WORKER_AUDIT_DELIVERY_BATCH=25
WORKER_PLATFORM_JOB_BATCH=1
WORKER_HEALTH_PORT=8081
WEBHOOK_TIMEOUT_MS=10000
REQUIRE_WORKER=true
METRICS_TOKEN=
# Process name used in logs, metrics, and PostgreSQL application_name.
SERVICE_NAME=signalhub
# Permit plain-HTTP audit sinks (not recommended outside isolated networks).
ALLOW_INSECURE_AUDIT_SINKS=false
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# One-time bootstrap identity. Prefer piping the password to
# `npm run bootstrap -- --password-stdin`; do not commit a password here.
STATUS_BOOTSTRAP_EMAIL=admin@example.com
STATUS_BOOTSTRAP_NAME=Instance Administrator
STATUS_BOOTSTRAP_ORG_NAME=Example Organization
STATUS_BOOTSTRAP_ORG_SLUG=example
