# Minimal SignalHub configuration.
# Copy to .env for local development or a Node.js deployment.
# Start with npm run dev / npm run dev:all, or npm run start:all after building.
# Blank core values let the setup wizard use saved configuration.
# Advanced options and their defaults: docs/configuration.md

# PostgreSQL connection. Leave blank to enter it at /setup.
DATABASE_URL=

# Generated and saved automatically by the supervisor when left blank.
# For manually managed deployments, generate each value separately with:
# openssl rand -base64 48
# Keep these keys stable and back them up separately from the database.
SESSION_SECRET=
ENCRYPTION_KEY=

# URL serving this application (which may differ from the marketing website).
# Leave blank to configure it through setup or the admin console.
NEXT_PUBLIC_APP_URL=

# Optional: enable the linked hosting credit on the Miget-hosted public demo.
SIGNALHUB_MIGET_ATTRIBUTION=false

# Docker: ./install.sh creates the deployment .env for you.
# When configuring Compose manually, use these aliases instead of the
# DATABASE_URL and NEXT_PUBLIC_APP_URL entries above:
# SIGNALHUB_DATABASE_URL=
# SIGNALHUB_PUBLIC_URL=
# Bundled PostgreSQL, HTTPS, ports, images and other options: docs/configuration.md
