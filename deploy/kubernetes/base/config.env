# Non-secret settings (see docs/configuration.md for the full list).
NEXT_PUBLIC_APP_URL=https://status.example.com
STATUS_BOOTSTRAP_NAME=Instance Administrator
STATUS_BOOTSTRAP_ORG_NAME=Default Organization
STATUS_BOOTSTRAP_ORG_SLUG=default
# Proxy trust (X-Forwarded-For) is managed in Platform administration > Configuration:
# the default (Auto) trusts your ingress on the cluster network. To pin it in config
# instead: TRUST_PROXY_HEADERS=auto|true|false, TRUSTED_PROXY_HOPS=1, TRUSTED_PROXY_CIDRS=10.244.0.0/16
LOG_LEVEL=info
REQUIRE_WORKER=true
WORKER_HEALTH_PORT=8081
