# Copy to secrets.env (git-ignored) and fill in. kubectl apply -k turns it into a Secret.
#
# Direct (session) connection, not a transaction pooler. Managed databases:
# append ?sslmode=verify-full, or put the provider CA in DATABASE_SSL_CA.
DATABASE_URL=postgresql://signalhub:CHANGE_ME@your-db-host:5432/signalhub?sslmode=verify-full
# openssl rand -base64 48   (each; keep ENCRYPTION_KEY backed up separately)
SESSION_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
# First administrator, created once on an empty database (password is changed at first login).
STATUS_BOOTSTRAP_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD
STATUS_BOOTSTRAP_USERNAME=admin
STATUS_BOOTSTRAP_EMAIL=you@example.com
# Only for the with-postgres overlay: the bundled database password (must match DATABASE_URL).
# POSTGRES_PASSWORD=CHANGE_ME
