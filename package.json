{
  "name": "signalhub",
  "version": "1.0.0",
  "private": true,
  "description": "Reliable Apache-2.0 self-hosted status pages, monitoring, and incident communication",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev --webpack -p 3301",
    "build": "npm run build:web && npm run build:runtime",
    "build:web": "next build --webpack",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-runtime/worker.mjs",
    "build:cli": "esbuild scripts/migrate.ts scripts/bootstrap.ts scripts/statusctl.ts scripts/signalhubctl.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-runtime --out-extension:.js=.mjs",
    "build:runtime": "npm run build:worker && npm run build:cli",
    "start": "next start -p 3301",
    "start:worker": "node dist-runtime/worker.mjs",
    "worker:dev": "tsx --env-file=.env worker/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:seed-roles": "tsx --env-file=.env scripts/seed-role-users.ts",
    "db:reset-dev": "tsx --env-file=.env scripts/reset-development.ts",
    "bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "signalhubctl": "tsx --env-file=.env scripts/signalhubctl.ts",
    "statusctl": "tsx --env-file=.env scripts/statusctl.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.74.5",
    "@node-rs/argon2": "^2.0.2",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@react-three/fiber": "^9.7.0",
    "@types/pg": "^8.21.0",
    "bcryptjs": "^3.0.2",
    "graphile-worker": "^0.17.3",
    "jose": "^6.2.8",
    "kysely": "^0.29.5",
    "lucide-react": "^1.31.0",
    "motion": "^13.0.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "postcss": "$postcss",
    "next": {
      "sharp": "0.35.3"
    }
  }
}
