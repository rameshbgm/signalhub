{
  "name": "signalhub",
  "version": "1.0.0",
  "private": true,
  "description": "Reliable Apache-2.0 self-hosted status pages, monitoring, and incident communication",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rameshbgm/signalhub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rameshbgm/signalhub.git"
  },
  "bugs": {
    "url": "https://github.com/rameshbgm/signalhub/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env scripts/start.ts --dev --role web",
    "dev:web": "next dev --webpack -p 3301",
    "dev:all": "tsx --env-file-if-exists=.env scripts/start.ts --dev",
    "build": "npm run build:web && npm run build:runtime",
    "build:web": "next build --webpack && npm run build:assets",
    "build:assets": "node -e \"const fs=require('node:fs');fs.cpSync('public','.next/standalone/public',{recursive:true});fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true})\"",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-runtime/worker.mjs",
    "build:cli": "esbuild scripts/start.ts scripts/migrate.ts scripts/bootstrap.ts scripts/statusctl.ts scripts/signalhubctl.ts scripts/peer-address.mjs --bundle --platform=node --format=esm --packages=external --outdir=dist-runtime --out-extension:.js=.mjs",
    "build:runtime": "npm run build:worker && npm run build:cli",
    "start": "next start -p 3301",
    "start:all": "node --env-file-if-exists=.env dist-runtime/start.mjs",
    "start:worker": "node dist-runtime/worker.mjs",
    "worker:dev": "tsx --env-file-if-exists=.env worker/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap.ts",
    "signalhubctl": "tsx --env-file-if-exists=.env scripts/signalhubctl.ts",
    "statusctl": "tsx --env-file-if-exists=.env scripts/statusctl.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.2.2",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bcryptjs": "^3.0.3",
    "graphile-worker": "^0.18.0",
    "jose": "^6.2.13",
    "kysely": "^0.29.7",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "socks": "^2.8.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
