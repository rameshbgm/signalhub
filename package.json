{
  "name": "signalhub",
  "version": "1.0.0",
  "private": true,
  "description": "Reliable Apache-2.0 self-hosted status pages, monitoring, and incident communication",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev --webpack -p 3301",
    "build": "npm run build:web && npm run build:runtime",
    "build:web": "next build --webpack",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-runtime/worker.mjs",
    "build:cli": "esbuild scripts/migrate.ts scripts/bootstrap.ts scripts/statusctl.ts scripts/signalhubctl.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-runtime --out-extension:.js=.mjs",
    "build:runtime": "npm run build:worker && npm run build:cli",
    "start": "next start -p 3301",
    "start:worker": "node dist-runtime/worker.mjs",
    "worker:dev": "tsx --env-file=.env worker/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:indexes": "tsx --env-file=.env scripts/ensure-indexes.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:seed-roles": "tsx --env-file=.env scripts/seed-role-users.ts",
    "bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "signalhubctl": "tsx --env-file=.env scripts/signalhubctl.ts",
    "statusctl": "tsx --env-file=.env scripts/statusctl.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@node-rs/argon2": "^2.0.2",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "jose": "^6.1.0",
    "mongodb": "^7.5.0",
    "nanoid": "^5.1.6",
    "next": "^16.2.11",
    "nodemailer": "^9.0.3",
    "prom-client": "^15.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "postcss": "$postcss",
    "next": {
      "sharp": "0.35.3"
    }
  }
}
