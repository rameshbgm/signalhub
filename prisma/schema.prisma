generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Organization & Team ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  createdAt DateTime @default(now())

  teamMembers TeamMember[]
  apiKeys     ApiKey[]
  pages       Page[]
  auditLogs   AuditLog[]
}

model TeamMember {
  id           String   @id @default(cuid())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  email        String
  passwordHash String
  name         String
  role         String   @default("ADMIN") // OWNER, ADMIN, EDITOR, RESPONDER
  twoFactorEnabled Boolean @default(false)
  createdAt    DateTime @default(now())

  @@unique([orgId, email])
}

model ApiKey {
  id           String   @id @default(cuid())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  name         String
  key          String   @unique
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
}

model AuditLog {
  id           String   @id @default(cuid())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  actor        String
  action       String
  target       String
  createdAt    DateTime @default(now())
}

// ---------- Pages ----------

model Page {
  id             String   @id @default(cuid())
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId          String
  name           String
  slug           String   @unique
  type           String   @default("PUBLIC") // PUBLIC, PRIVATE, AUDIENCE
  isHub          Boolean  @default(false)
  hubParent      Page?    @relation("HubChildren", fields: [hubParentId], references: [id])
  hubParentId    String?
  hubChildren    Page[]   @relation("HubChildren")
  timezone       String   @default("UTC")
  language       String   @default("en")
  headline       String   @default("Service Status")
  aboutText      String   @default("")
  logoUrl        String?
  faviconUrl     String?
  brandColor     String   @default("#0052CC")
  supportUrl     String?
  customDomain   String?
  passwordHash   String?
  removeBranding Boolean  @default(false)
  customCss      String?
  createdAt      DateTime @default(now())

  componentGroups   ComponentGroup[]
  components        Component[]
  incidents         Incident[]
  subscribers       Subscriber[]
  metrics           Metric[]
  templates         IncidentTemplate[]
  templateGroups    TemplateGroup[]
  webhookEndpoints  WebhookEndpoint[]
  accessUsers       PageAccessUser[]
  accessGroups      PageAccessGroup[]
}

model PageAccessGroup {
  id     String @id @default(cuid())
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String
  name   String
  componentIds String @default("[]") // JSON array of component ids visible to this group

  users PageAccessUser[]
}

model PageAccessUser {
  id           String   @id @default(cuid())
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId       String
  email        String
  passwordHash String
  group        PageAccessGroup? @relation(fields: [groupId], references: [id])
  groupId      String?
  componentIds String   @default("[]") // JSON array, overrides/extends group access
  createdAt    DateTime @default(now())

  @@unique([pageId, email])
}

// ---------- Components ----------

model ComponentGroup {
  id          String  @id @default(cuid())
  page        Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      String
  name        String
  description String  @default("")
  order       Int     @default(0)
  collapsed   Boolean @default(false)

  components Component[]
}

model Component {
  id                 String   @id @default(cuid())
  page               Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId             String
  group              ComponentGroup? @relation(fields: [groupId], references: [id])
  groupId            String?
  name               String
  description        String   @default("")
  status             String   @default("OPERATIONAL") // OPERATIONAL, DEGRADED_PERFORMANCE, PARTIAL_OUTAGE, MAJOR_OUTAGE, UNDER_MAINTENANCE
  order              Int      @default(0)
  visible            Boolean  @default(true)
  showUptime         Boolean  @default(true)
  isThirdParty       Boolean  @default(false)
  thirdPartyProvider String?
  automationToken    String   @unique @default(cuid())
  createdAt          DateTime @default(now())

  incidentComponents IncidentComponent[]
  statusEvents       ComponentStatusEvent[]
  metrics            Metric[]
}

// Tracks status changes over time so uptime % can be computed accurately.
model ComponentStatusEvent {
  id          String    @id @default(cuid())
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  componentId String
  status      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  isMaintenance Boolean @default(false)
}

// ---------- Incidents ----------

model Incident {
  id            String   @id @default(cuid())
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId        String
  name          String
  status        String   @default("INVESTIGATING") // INVESTIGATING, IDENTIFIED, MONITORING, RESOLVED
  impact        String   @default("MINOR") // NONE, MINOR, MAJOR, CRITICAL
  isMaintenance Boolean  @default(false)
  maintenanceStatus String? // SCHEDULED, IN_PROGRESS, VERIFYING, COMPLETED
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  autoTransition Boolean @default(false)
  notifySubscribers Boolean @default(true)
  postmortemBody     String?
  postmortemPublishedAt DateTime?
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  backfilled    Boolean  @default(false)

  updates    IncidentUpdate[]
  components IncidentComponent[]
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String
  status     String
  body       String
  createdAt  DateTime @default(now())
  notified   Boolean  @default(false)
}

model IncidentComponent {
  id          String    @id @default(cuid())
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId  String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  componentId String
  newStatus   String

  @@unique([incidentId, componentId])
}

model TemplateGroup {
  id     String @id @default(cuid())
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String
  name   String

  templates IncidentTemplate[]
}

model IncidentTemplate {
  id                 String   @id @default(cuid())
  page               Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId             String
  group              TemplateGroup? @relation(fields: [groupId], references: [id])
  groupId            String?
  title              String
  body               String
  defaultStatus      String   @default("INVESTIGATING")
  defaultImpact      String   @default("MINOR")
  defaultComponentIds String  @default("[]")
  createdAt          DateTime @default(now())
}

// ---------- Subscribers ----------

model Subscriber {
  id               String   @id @default(cuid())
  page             Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId           String
  channel          String   // EMAIL, SMS, WEBHOOK, SLACK
  contact          String   // email address, phone number, webhook url, slack webhook url
  componentIds     String   @default("[]") // JSON array; empty = all components
  verified         Boolean  @default(false)
  quarantined      Boolean  @default(false)
  unsubscribeToken String   @unique @default(cuid())
  createdAt        DateTime @default(now())

  @@unique([pageId, channel, contact])
}

model SubscriptionOtp {
  id        String   @id @default(cuid())
  pageId    String
  channel   String
  contact   String
  code      String
  componentIds String @default("[]")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------- Metrics ----------

model Metric {
  id          String   @id @default(cuid())
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      String
  component   Component? @relation(fields: [componentId], references: [id])
  componentId String?
  name        String
  suffix      String   @default("")
  description String   @default("")
  visible     Boolean  @default(true)
  decimals    Int      @default(0)

  points MetricPoint[]
}

model MetricPoint {
  id        String   @id @default(cuid())
  metric    Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  metricId  String
  timestamp DateTime @default(now())
  value     Float
}

// ---------- Webhooks / Notifications log ----------

model WebhookEndpoint {
  id        String   @id @default(cuid())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  url       String
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NotificationLog {
  id        String   @id @default(cuid())
  pageId    String
  channel   String
  contact   String
  subject   String
  body      String
  status    String   @default("SENT") // SENT, FAILED
  createdAt DateTime @default(now())
}

// ---------- Third-party provider catalog ----------

model ThirdPartyProvider {
  id       String @id @default(cuid())
  name     String
  category String
  homepage String @default("")
}
